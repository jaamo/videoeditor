# OpenAI, for transcribing (Whisper): platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs, for cleaning the voice (needs the audio isolation permission). Optional:
# without it the voice is only filtered locally.
ELEVENLABS_API_KEY=

# Releasing (npm run release): only for the platforms you post to.
# YouTube: console.cloud.google.com, a project with the YouTube Data API v3, an OAuth client
# of type "Desktop app"; its consent screen In production (in Testing the sign-in lasts 7 days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok: developers.tiktok.com, the app's sandbox (Desktop, Login Kit + Content Posting API,
# redirect URI http://localhost:8765/callback/): its Client key and secret. See the README.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=     # only if a different one is registered
# Instagram: a system user's token from Business Settings (see the README), for
# npm run release -- login instagram, which then keeps it. An Instagram Login token (IGAA…)
# works too, but needs cloudflared; a plain Facebook user token needs the app's ID and secret.
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
