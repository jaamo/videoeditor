node_modules/
.env
__pycache__/

# Music tracks: large, and licensed separately. Put tracks in assets/music/.
assets/music/*
!assets/music/.gitkeep

# Projects: footage, sound, frames and renders are remade or dropped in; the decisions
# (project.yaml, plan.yaml, the .kdenlive, captions.txt, findings, reviews) are kept.
projects/*/footage/
projects/*/tmp/
projects/*/*.mp4
projects/*/*.mov
projects/*/*.MOV
projects/*/*.MP4
projects/*/*.mkv
projects/*/*.webm
projects/*/*.avi
projects/*/*.m4v
projects/*/*.mts
projects/*/*.MTS
projects/*/unused/
projects/*/analysis/sort/
projects/*/analysis/*.wav
projects/*/analysis/frames/
projects/*/analysis/sheets/
projects/*/review/
projects/*/proxy/
projects/*/.frame-*.kdenlive

# Projects stay local: only the empty folder is in git.
projects/*
!projects/.gitkeep
