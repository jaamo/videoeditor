Dialogue: 0,00:00:00.00,00:00:00.50,Default,,0,0,0,,Mun mielestä
Dialogue: 0,00:00:00.50,00:00:01.40,Default,,0,0,0,,pyöräillessä on
Dialogue: 0,00:00:01.40,00:00:03.80,Default,,0,0,0,,valtaosassa tilanteista
Dialogue: 0,00:00:03.80,00:00:05.50,Default,,0,0,0,,kaksi vaihtoehtoa,
Dialogue: 0,00:00:05.50,00:00:05.93,Default,,0,0,0,,miten niihin
Dialogue: 0,00:00:05.93,00:00:06.77,Default,,0,0,0,,reagoida.
Dialogue: 0,00:00:06.80,00:00:07.47,Default,,0,0,0,,Voi joko
Dialogue: 0,00:00:07.47,00:00:08.00,Default,,0,0,0,,kiihdyttää
Dialogue: 0,00:00:08.00,00:00:09.03,Default,,0,0,0,,vauhtia,
Dialogue: 0,00:00:09.03,00:00:09.90,Default,,0,0,0,,tai sitten voi
Dialogue: 0,00:00:09.90,00:00:11.27,Default,,0,0,0,,hidastaa vauhtia.
Dialogue: 0,00:00:11.27,00:00:11.67,Default,,0,0,0,,Jos miettii
Dialogue: 0,00:00:11.67,00:00:12.57,Default,,0,0,0,,tilannetta,
Dialogue: 0,00:00:13.07,00:00:13.77,Default,,0,0,0,,että mahtuuko
Dialogue: 0,00:00:13.77,00:00:14.90,Default,,0,0,0,,tuosta ohi,
Dialogue: 0,00:00:14.90,00:00:15.50,Default,,0,0,0,,tai ehdinkö minä
Dialogue: 0,00:00:15.50,00:00:15.87,Default,,0,0,0,,vielä noista
Dialogue: 0,00:00:15.87,00:00:16.87,Default,,0,0,0,,valoista,
Dialogue: 0,00:00:17.00,00:00:17.57,Default,,0,0,0,,tai mitenhän minun
Dialogue: 0,00:00:17.57,00:00:18.27,Default,,0,0,0,,kannattaa tuohon
Dialogue: 0,00:00:18.27,00:00:19.70,Default,,0,0,0,,mutkaan ajaa,
Dialogue: 0,00:00:19.73,00:00:19.93,Default,,0,0,0,,niin
Dialogue: 0,00:00:19.97,00:00:21.53,Default,,0,0,0,,aina on kaksi vaihtoehtoa
Dialogue: 0,00:00:21.60,00:00:22.80,Default,,0,0,0,,vähän lisätä vauhtia
Dialogue: 0,00:00:22.80,00:00:23.50,Default,,0,0,0,,ja vähän hidastaa.
Dialogue: 0,00:00:23.50,00:00:24.37,Default,,0,0,0,,Valtaosa
Dialogue: 0,00:00:24.37,00:00:26.00,Default,,0,0,0,,läheltä piti
Dialogue: 0,00:00:26.00,00:00:26.43,Default,,0,0,0,,-tilanteista,
Dialogue: 0,00:00:26.43,00:00:27.27,Default,,0,0,0,,mitä itsekin
Dialogue: 0,00:00:27.27,00:00:28.07,Default,,0,0,0,,aiheuttaa,
Dialogue: 0,00:00:28.07,00:00:28.60,Default,,0,0,0,,johtuu siitä,
Dialogue: 0,00:00:28.60,00:00:28.97,Default,,0,0,0,,että minä itse-
Dialogue: 0,00:00:28.97,00:00:29.27,Default,,0,0,0,,asiassa lähdin
Dialogue: 0,00:00:29.27,00:00:29.73,Default,,0,0,0,,kiihdyttämään
Dialogue: 0,00:00:29.73,00:00:30.30,Default,,0,0,0,,vauhtia,
Dialogue: 0,00:00:30.30,00:00:31.20,Default,,0,0,0,,enkä vain malttanut
Dialogue: 0,00:00:31.20,00:00:31.90,Default,,0,0,0,,ja pikkasen
Dialogue: 0,00:00:31.90,00:00:32.40,Default,,0,0,0,,hidastaa
Dialogue: 0,00:00:32.40,00:00:33.20,Default,,0,0,0,,vauhtia.
Dialogue: 0,00:00:33.20,00:00:34.07,Default,,0,0,0,,Minä jakelen
Dialogue: 0,00:00:34.07,00:00:34.37,Default,,0,0,0,,näitä
Dialogue: 0,00:00:34.37,00:00:35.93,Default,,0,0,0,,liikenneviisauksia,
Dialogue: 0,00:00:35.97,00:00:36.23,Default,,0,0,0,,minä en ole
Dialogue: 0,00:00:36.23,00:00:37.73,Default,,0,0,0,,itse mikään puhdas
Dialogue: 0,00:00:37.73,00:00:38.63,Default,,0,0,0,,pulmunen.
Dialogue: 0,00:00:38.63,00:00:39.23,Default,,0,0,0,,Tulee välillä,
Dialogue: 0,00:00:39.23,00:00:39.57,Default,,0,0,0,,että tulee liian
Dialogue: 0,00:00:39.57,00:00:39.97,Default,,0,0,0,,kovaa,
Dialogue: 0,00:00:39.97,00:00:40.53,Default,,0,0,0,,mutta vahva
Dialogue: 0,00:00:40.53,00:00:41.80,Default,,0,0,0,,suositus vauhdin
Dialogue: 0,00:00:41.80,00:00:42.83,Default,,0,0,0,,hidastamiselle.
