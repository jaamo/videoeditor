  <property name="kdenlive:sequenceproperties.guides">[
    {
        "comment": "1: the hook (\"Mä oon täällä taas jeesustelemassa\"), then the Sunday ride, up to \"oli\"",
        "duration": 0,
        "pos": 0,
        "type": 0
    },
    {
        "comment": "2: \"koira silleen\" stumble and the pause before it out; the dog walker, slowing down, the thanks",
        "duration": 0,
        "pos": 142,
        "type": 0
    },
    {
        "comment": "3: today's story starts; breath before it out",
        "duration": 0,
        "pos": 388,
        "type": 0
    },
    {
        "comment": "4: rang the bell and thanked him passing by; pause out",
        "duration": 0,
        "pos": 535,
        "type": 0
    },
    {
        "comment": "5: \"Sitten jäin\", the pause after it out",
        "duration": 0,
        "pos": 645,
        "type": 0
    },
    {
        "comment": "6: he walked 100 m back to thank him for ringing the bell",
        "duration": 0,
        "pos": 670,
        "type": 0
    },
    {
