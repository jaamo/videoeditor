Dialogue: 0,00:00:00.00,00:00:00.83,Default,,0,0,0,,Mä oon täällä taas
Dialogue: 0,00:00:00.83,00:00:02.17,Default,,0,0,0,,jeesustelemassa.
Dialogue: 0,00:00:02.40,00:00:02.93,Default,,0,0,0,,Olin sunnuntaina
Dialogue: 0,00:00:02.93,00:00:03.63,Default,,0,0,0,,pari päivää sitten
Dialogue: 0,00:00:03.63,00:00:04.73,Default,,0,0,0,,pyörälenkillä. Oli
Dialogue: 0,00:00:04.77,00:00:05.03,Default,,0,0,0,,koiran-
Dialogue: 0,00:00:05.03,00:00:05.80,Default,,0,0,0,,ulkoiluttaja
Dialogue: 0,00:00:05.80,00:00:06.47,Default,,0,0,0,,tossa, niin sit
Dialogue: 0,00:00:06.47,00:00:06.77,Default,,0,0,0,,hidastin
Dialogue: 0,00:00:06.77,00:00:07.47,Default,,0,0,0,,tosi paljon
Dialogue: 0,00:00:07.47,00:00:08.07,Default,,0,0,0,,vauhtia ja kiersin
Dialogue: 0,00:00:08.07,00:00:09.33,Default,,0,0,0,,ne silleen varovasti.
Dialogue: 0,00:00:09.73,00:00:10.70,Default,,0,0,0,,Hän kiitti oikeen
Dialogue: 0,00:00:10.70,00:00:11.70,Default,,0,0,0,,ääneen siitä,
Dialogue: 0,00:00:11.70,00:00:12.37,Default,,0,0,0,,että hidastin
Dialogue: 0,00:00:12.37,00:00:13.17,Default,,0,0,0,,vauhtia.
Dialogue: 0,00:00:13.17,00:00:14.17,Default,,0,0,0,,Sitten äsken olin
Dialogue: 0,00:00:14.17,00:00:14.63,Default,,0,0,0,,tämmösellä
Dialogue: 0,00:00:14.63,00:00:15.53,Default,,0,0,0,,ulkoilutiellä,
Dialogue: 0,00:00:15.53,00:00:16.43,Default,,0,0,0,,oli koiran-
Dialogue: 0,00:00:16.43,00:00:17.17,Default,,0,0,0,,ulkoiluttaja ja koira
Dialogue: 0,00:00:17.17,00:00:18.40,Default,,0,0,0,,eri puolilla tietä,
Dialogue: 0,00:00:18.40,00:00:18.93,Default,,0,0,0,,ja sitten soitin
Dialogue: 0,00:00:18.93,00:00:20.17,Default,,0,0,0,,kelloa ja kiitin
Dialogue: 0,00:00:20.17,00:00:21.53,Default,,0,0,0,,siinä ohittaessa.
Dialogue: 0,00:00:21.57,00:00:22.90,Default,,0,0,0,,Sitten jäin tuohon
Dialogue: 0,00:00:22.90,00:00:23.70,Default,,0,0,0,,ulkosalille,
Dialogue: 0,00:00:23.70,00:00:24.43,Default,,0,0,0,,hän käveli mun
Dialogue: 0,00:00:24.43,00:00:24.93,Default,,0,0,0,,perässä ja
Dialogue: 0,00:00:24.93,00:00:25.23,Default,,0,0,0,,teki semmosen
Dialogue: 0,00:00:25.23,00:00:25.80,Default,,0,0,0,,sadan metrin
Dialogue: 0,00:00:25.80,00:00:26.63,Default,,0,0,0,,koukkauksen ja
Dialogue: 0,00:00:26.63,00:00:27.37,Default,,0,0,0,,tuli kiittämään
Dialogue: 0,00:00:27.37,00:00:27.73,Default,,0,0,0,,mua siitä,
Dialogue: 0,00:00:27.73,00:00:28.37,Default,,0,0,0,,että kiitos kun
Dialogue: 0,00:00:28.37,00:00:28.93,Default,,0,0,0,,soitit sitä
Dialogue: 0,00:00:28.93,00:00:29.53,Default,,0,0,0,,kelloa,
Dialogue: 0,00:00:29.53,00:00:30.17,Default,,0,0,0,,ettei hän kuule,
Dialogue: 0,00:00:30.17,00:00:30.87,Default,,0,0,0,,kun pyörät tulee
Dialogue: 0,00:00:30.87,00:00:31.47,Default,,0,0,0,,lujaa.
Dialogue: 0,00:00:31.47,00:00:32.00,Default,,0,0,0,,Tänä päivänä
Dialogue: 0,00:00:32.00,00:00:32.90,Default,,0,0,0,,maailmassa on aika
Dialogue: 0,00:00:32.90,00:00:33.83,Default,,0,0,0,,paljon kaikkea
Dialogue: 0,00:00:33.83,00:00:35.47,Default,,0,0,0,,negatiivisuutta
Dialogue: 0,00:00:35.47,00:00:35.83,Default,,0,0,0,,ja muuta,
Dialogue: 0,00:00:35.83,00:00:36.37,Default,,0,0,0,,niin tää on
Dialogue: 0,00:00:36.37,00:00:37.53,Default,,0,0,0,,ilmainen tapa
Dialogue: 0,00:00:37.53,00:00:38.30,Default,,0,0,0,,saada ihmisille
Dialogue: 0,00:00:38.30,00:00:39.43,Default,,0,0,0,,hyvä fiilis.
Dialogue: 0,00:00:39.43,00:00:40.47,Default,,0,0,0,,Ja myös itelle.
Dialogue: 0,00:00:40.47,00:00:41.23,Default,,0,0,0,,Ei voi kuin
Dialogue: 0,00:00:41.23,00:00:41.90,Default,,0,0,0,,suositella.
