Dialogue: 0,00:00:00.00,00:00:00.83,Default,,0,0,0,,Haluatteko tietää,
Dialogue: 0,00:00:00.83,00:00:01.23,Default,,0,0,0,,mikä on mun
Dialogue: 0,00:00:01.23,00:00:01.40,Default,,0,0,0,,mielestä
Dialogue: 0,00:00:01.40,00:00:03.47,Default,,0,0,0,,pyöräilyhistorian
Dialogue: 0,00:00:03.47,00:00:04.53,Default,,0,0,0,,ja teknologian
Dialogue: 0,00:00:04.53,00:00:05.33,Default,,0,0,0,,nerokkain
Dialogue: 0,00:00:05.33,00:00:06.13,Default,,0,0,0,,keksintö?
Dialogue: 0,00:00:06.13,00:00:07.67,Default,,0,0,0,,Se on tämä.
Dialogue: 0,00:00:07.67,00:00:08.87,Default,,0,0,0,,Vaijerin kireyden
Dialogue: 0,00:00:08.87,00:00:10.03,Default,,0,0,0,,säädin täällä
Dialogue: 0,00:00:10.03,00:00:11.57,Default,,0,0,0,,vaijerin etupäässä.
Dialogue: 0,00:00:11.57,00:00:12.33,Default,,0,0,0,,Tässähän on se
Dialogue: 0,00:00:12.33,00:00:13.43,Default,,0,0,0,,hyvä puoli,
Dialogue: 0,00:00:13.43,00:00:14.17,Default,,0,0,0,,että kun
Dialogue: 0,00:00:14.17,00:00:14.97,Default,,0,0,0,,ajan ja jos
Dialogue: 0,00:00:14.97,00:00:15.60,Default,,0,0,0,,vaihteet eivät
Dialogue: 0,00:00:15.60,00:00:16.93,Default,,0,0,0,,ole ihan vireessä,
Dialogue: 0,00:00:17.23,00:00:17.70,Default,,0,0,0,,niin mä pystyn
Dialogue: 0,00:00:17.70,00:00:19.07,Default,,0,0,0,,tässä ajaessa
Dialogue: 0,00:00:19.07,00:00:19.83,Default,,0,0,0,,säätää ja
Dialogue: 0,00:00:19.83,00:00:20.57,Default,,0,0,0,,hienosäätämään
Dialogue: 0,00:00:20.57,00:00:22.73,Default,,0,0,0,,vaihtajan toimintaa.
Dialogue: 0,00:00:22.73,00:00:23.23,Default,,0,0,0,,Käytännössähän se
Dialogue: 0,00:00:23.23,00:00:23.93,Default,,0,0,0,,tarkoittaa aina
Dialogue: 0,00:00:23.93,00:00:24.33,Default,,0,0,0,,vaijerin
Dialogue: 0,00:00:24.33,00:00:25.23,Default,,0,0,0,,kiristämistä,
Dialogue: 0,00:00:25.23,00:00:25.77,Default,,0,0,0,,koska ei se
Dialogue: 0,00:00:25.77,00:00:26.77,Default,,0,0,0,,vaijeri itsestään
Dialogue: 0,00:00:26.77,00:00:27.30,Default,,0,0,0,,kiristy,
Dialogue: 0,00:00:27.30,00:00:27.60,Default,,0,0,0,,mutta se kyllä
Dialogue: 0,00:00:27.60,00:00:28.53,Default,,0,0,0,,itsestään löystyy.
Dialogue: 0,00:00:28.53,00:00:29.57,Default,,0,0,0,,Eli katsoo vaan
Dialogue: 0,00:00:29.57,00:00:30.47,Default,,0,0,0,,etukäteen,
Dialogue: 0,00:00:30.47,00:00:30.87,Default,,0,0,0,,että kumpaan
Dialogue: 0,00:00:30.87,00:00:31.33,Default,,0,0,0,,suuntaan tätä
Dialogue: 0,00:00:31.33,00:00:32.10,Default,,0,0,0,,pitää säätää,
Dialogue: 0,00:00:32.10,00:00:33.00,Default,,0,0,0,,että se vaijeri
Dialogue: 0,00:00:33.00,00:00:33.77,Default,,0,0,0,,kiristyy.
Dialogue: 0,00:00:33.77,00:00:34.37,Default,,0,0,0,,Jos vaihteet eivät
Dialogue: 0,00:00:34.37,00:00:35.63,Default,,0,0,0,,toimi neljännes
Dialogue: 0,00:00:35.63,00:00:36.00,Default,,0,0,0,,kierros
Dialogue: 0,00:00:36.00,00:00:36.90,Default,,0,0,0,,kerrallaan,
Dialogue: 0,00:00:36.90,00:00:37.47,Default,,0,0,0,,pikkuhiljaa
Dialogue: 0,00:00:37.47,00:00:38.27,Default,,0,0,0,,kiristää silleen,
Dialogue: 0,00:00:38.27,00:00:38.90,Default,,0,0,0,,että oikea
Dialogue: 0,00:00:38.90,00:00:39.77,Default,,0,0,0,,kohta löytyy.
Dialogue: 0,00:00:39.77,00:00:41.07,Default,,0,0,0,,Täydellinen keksintö.
