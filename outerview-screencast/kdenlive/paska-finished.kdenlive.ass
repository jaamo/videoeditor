Dialogue: 0,0:00:00.00,0:00:00.80,Default,,0,0,0,,Moikka!
Dialogue: 0,0:00:00.80,0:00:02.04,Default,,0,0,0,,Mä haluaisin nyt näyttää
Dialogue: 0,0:00:02.04,0:00:02.52,Default,,0,0,0,,teille,
Dialogue: 0,0:00:02.52,0:00:03.84,Default,,0,0,0,,miten tämä meidän tuote
Dialogue: 0,0:00:03.84,0:00:05.16,Default,,0,0,0,,Audiovy oikein toimii.
Dialogue: 0,0:00:05.16,0:00:06.72,Default,,0,0,0,,Tämä on siis työkalu,
Dialogue: 0,0:00:06.72,0:00:07.80,Default,,0,0,0,,mikä tekee ja luo
Dialogue: 0,0:00:07.80,0:00:09.56,Default,,0,0,0,,sisältöjä keskustelujen
Dialogue: 0,0:00:09.56,0:00:10.52,Default,,0,0,0,,pohjalta.
Dialogue: 0,0:00:10.52,0:00:11.44,Default,,0,0,0,,Mä oon tästä nyt
Dialogue: 0,0:00:11.44,0:00:12.40,Default,,0,0,0,,kirjautunut tänne
Dialogue: 0,0:00:12.40,0:00:13.64,Default,,0,0,0,,palveluun sisään ja mä
Dialogue: 0,0:00:13.64,0:00:14.68,Default,,0,0,0,,voin tästä aloittaa
Dialogue: 0,0:00:14.68,0:00:16.00,Default,,0,0,0,,uuden keskustelun,
Dialogue: 0,0:00:16.00,0:00:17.32,Default,,0,0,0,,jossa te haastattila
Dialogue: 0,0:00:17.32,0:00:19.16,Default,,0,0,0,,lähtee kyselemään multa,
Dialogue: 0,0:00:19.16,0:00:20.72,Default,,0,0,0,,miten mulla on mennyt,
Dialogue: 0,0:00:20.72,0:00:21.40,Default,,0,0,0,,mutta jos mulla on
Dialogue: 0,0:00:21.40,0:00:21.92,Default,,0,0,0,,valmis aihe,
Dialogue: 0,0:00:21.92,0:00:22.76,Default,,0,0,0,,niin mä voin lähteä
Dialogue: 0,0:00:22.76,0:00:24.00,Default,,0,0,0,,tästä liikkeelle.
Dialogue: 0,0:00:24.00,0:00:25.52,Default,,0,0,0,,Otetaan tästä joku aihe.
Dialogue: 0,0:00:25.52,0:00:26.40,Default,,0,0,0,,Mä laitan tähän vaikka
Dialogue: 0,0:00:26.40,0:00:26.88,Default,,0,0,0,,semmoisen,
Dialogue: 0,0:00:26.88,0:00:29.04,Default,,0,0,0,,että miksi tekoäly ei
Dialogue: 0,0:00:29.04,0:00:31.52,Default,,0,0,0,,tehnyt minusta hyvää
Dialogue: 0,0:00:31.52,0:00:33.76,Default,,0,0,0,,suunnittelijaa.
Dialogue: 0,0:00:33.76,0:00:35.52,Default,,0,0,0,,Ja sitten me lähdetään
Dialogue: 0,0:00:35.52,0:00:37.48,Default,,0,0,0,,haastattelemaan tänne.
Dialogue: 0,0:00:37.68,0:00:38.28,Default,,0,0,0,,Loikka Jaakko,
Dialogue: 0,0:00:38.28,0:00:39.32,Default,,0,0,0,,mennään suoraan sun
Dialogue: 0,0:00:39.32,0:00:39.92,Default,,0,0,0,,ideaan.
Dialogue: 0,0:00:39.92,0:00:40.84,Default,,0,0,0,,Sä oot miettinyt,
Dialogue: 0,0:00:40.84,0:00:41.96,Default,,0,0,0,,miksi tekoäly ei tehnyt
Dialogue: 0,0:00:41.96,0:00:42.60,Default,,0,0,0,,susta hyvää
Dialogue: 0,0:00:42.60,0:00:43.68,Default,,0,0,0,,suunnittelijaa.
Dialogue: 0,0:00:43.68,0:00:45.00,Default,,0,0,0,,Mitä mieltä sä olet
Dialogue: 0,0:00:45.00,0:00:45.64,Default,,0,0,0,,siitä,
Dialogue: 0,0:00:45.64,0:00:46.96,Default,,0,0,0,,missä tekoäly oikeasti
Dialogue: 0,0:00:46.96,0:00:48.16,Default,,0,0,0,,epäonnistui suhteessa
Dialogue: 0,0:00:48.16,0:00:48.88,Default,,0,0,0,,omiin odotuksiisi
Dialogue: 0,0:00:48.88,0:00:49.88,Default,,0,0,0,,suunnittelussa?
Dialogue: 0,0:00:49.88,0:00:51.56,Default,,0,0,0,,Nyt mä voin jatkaa
Dialogue: 0,0:00:51.56,0:00:53.84,Default,,0,0,0,,tai keskustella Maijan
Dialogue: 0,0:00:53.84,0:00:55.56,Default,,0,0,0,,kanssa vapaasti
Dialogue: 0,0:00:55.56,0:00:57.16,Default,,0,0,0,,aiheesta.
Dialogue: 0,0:00:57.16,0:00:58.16,Default,,0,0,0,,Mä voin pyytää sitä
Dialogue: 0,0:00:58.16,0:00:59.24,Default,,0,0,0,,menemään eteenpäin,
Dialogue: 0,0:00:59.24,0:01:00.36,Default,,0,0,0,,menemään taaksepäin.
Dialogue: 0,0:01:00.36,0:01:01.20,Default,,0,0,0,,Nyt mä haluaisin vaan
Dialogue: 0,0:01:01.20,0:01:01.88,Default,,0,0,0,,sanoa tähän,
Dialogue: 0,0:01:01.88,0:01:02.64,Default,,0,0,0,,että mä oon huomannut
Dialogue: 0,0:01:02.64,0:01:04.12,Default,,0,0,0,,semmoisen asian,
Dialogue: 0,0:01:04.12,0:01:05.52,Default,,0,0,0,,että tekoäly teki aika
Dialogue: 0,0:01:05.52,0:01:06.00,Default,,0,0,0,,monista
Dialogue: 0,0:01:06.00,0:01:07.56,Default,,0,0,0,,suunnittelijoista hyviä
Dialogue: 0,0:01:07.56,0:01:08.24,Default,,0,0,0,,devaajia,
Dialogue: 0,0:01:08.24,0:01:09.12,Default,,0,0,0,,mutta devaajista ei
Dialogue: 0,0:01:09.12,0:01:09.92,Default,,0,0,0,,tullutkaan hyviä
Dialogue: 0,0:01:09.92,0:01:11.04,Default,,0,0,0,,suunnittelijoita.
Dialogue: 0,0:01:11.04,0:01:11.88,Default,,0,0,0,,Mä oon huomannut
Dialogue: 0,0:01:11.88,0:01:13.20,Default,,0,0,0,,tällaisen epäkohdan.
Dialogue: 0,0:01:13.20,0:01:14.12,Default,,0,0,0,,Mitäs mieltä sä oot
Dialogue: 0,0:01:14.12,0:01:14.60,Default,,0,0,0,,siitä?
Dialogue: 0,0:01:14.64,0:01:15.20,Default,,0,0,0,,No niinpä.
Dialogue: 0,0:01:15.20,0:01:16.56,Default,,0,0,0,,Miten muut kehittäjät ja
Dialogue: 0,0:01:16.56,0:01:17.64,Default,,0,0,0,,tekniset ihmiset sun
Dialogue: 0,0:01:17.64,0:01:18.72,Default,,0,0,0,,ympärillä suhtautuu
Dialogue: 0,0:01:18.72,0:01:19.92,Default,,0,0,0,,tähän alimetriaan
Dialogue: 0,0:01:19.92,0:01:20.92,Default,,0,0,0,,koodauksen ja designin
Dialogue: 0,0:01:20.92,0:01:21.56,Default,,0,0,0,,välillä?
Dialogue: 0,0:01:21.56,0:01:22.24,Default,,0,0,0,,Sitten kun olen
Dialogue: 0,0:01:22.24,0:01:22.84,Default,,0,0,0,,keskustellut
Dialogue: 0,0:01:22.84,0:01:23.68,Default,,0,0,0,,riittävästi,
Dialogue: 0,0:01:23.68,0:01:25.00,Default,,0,0,0,,lopetan haastattelun ja
Dialogue: 0,0:01:25.00,0:01:26.84,Default,,0,0,0,,lähdetään luomaan tämän
Dialogue: 0,0:01:26.84,0:01:28.24,Default,,0,0,0,,pohjalta sisältöjä.
Dialogue: 0,0:01:28.24,0:01:29.32,Default,,0,0,0,,Nyt tässä on muutama
Dialogue: 0,0:01:29.32,0:01:30.64,Default,,0,0,0,,tekoälyyn mulle tekemä
Dialogue: 0,0:01:30.64,0:01:31.40,Default,,0,0,0,,postaus.
Dialogue: 0,0:01:31.40,0:01:32.44,Default,,0,0,0,,Nämä on kirjoitettu siis
Dialogue: 0,0:01:32.44,0:01:33.40,Default,,0,0,0,,minun äänellän,
Dialogue: 0,0:01:33.40,0:01:34.28,Default,,0,0,0,,eli mä oon antanut
Dialogue: 0,0:01:34.28,0:01:35.72,Default,,0,0,0,,sinne taustatieluiksi
Dialogue: 0,0:01:35.72,0:01:36.72,Default,,0,0,0,,vähän mun sisältöä,
Dialogue: 0,0:01:36.72,0:01:37.84,Default,,0,0,0,,ne kuulostaa multa.
Dialogue: 0,0:01:37.84,0:01:39.16,Default,,0,0,0,,Otetaan nyt vaikka tästä
Dialogue: 0,0:01:39.16,0:01:40.48,Default,,0,0,0,,tämä sisältö meille,
Dialogue: 0,0:01:40.48,0:01:41.80,Default,,0,0,0,,avataan se ja lähdetään
Dialogue: 0,0:01:41.80,0:01:42.80,Default,,0,0,0,,muokkaamaan.
Dialogue: 0,0:01:42.80,0:01:44.72,Default,,0,0,0,,Annetaan sille neljä
Dialogue: 0,0:01:44.72,0:01:45.88,Default,,0,0,0,,tähteä.
Dialogue: 0,0:01:45.88,0:01:47.60,Default,,0,0,0,,Mä voin tästä muokata
Dialogue: 0,0:01:47.60,0:01:49.36,Default,,0,0,0,,tätä manuaalisesti,
Dialogue: 0,0:01:49.36,0:01:51.24,Default,,0,0,0,,kirjoittaa tänne lisää
Dialogue: 0,0:01:51.24,0:01:52.60,Default,,0,0,0,,jotain asiaa.
Dialogue: 0,0:01:52.60,0:01:53.56,Default,,0,0,0,,Tai sitten mä voin
Dialogue: 0,0:01:53.56,0:01:54.64,Default,,0,0,0,,pyytää tekoälyä
Dialogue: 0,0:01:54.64,0:01:56.32,Default,,0,0,0,,muokkaamaan tätä.
Dialogue: 0,0:01:56.32,0:01:57.92,Default,,0,0,0,,Tehdään tästä vaikka,
Dialogue: 0,0:01:57.92,0:02:00.32,Default,,0,0,0,,että lisää rävä kämpi
Dialogue: 0,0:02:00.32,0:02:03.48,Default,,0,0,0,,alku,
Dialogue: 0,0:02:03.48,0:02:04.68,Default,,0,0,0,,pyytää tekoäly
Dialogue: 0,0:02:04.68,0:02:06.32,Default,,0,0,0,,muokkaamaan sitä ja se
Dialogue: 0,0:02:06.32,0:02:07.84,Default,,0,0,0,,tekee tästä muulle
Dialogue: 0,0:02:07.84,0:02:09.24,Default,,0,0,0,,paremman version.
Dialogue: 0,0:02:09.24,0:02:09.88,Default,,0,0,0,,Ja kun tämä on
Dialogue: 0,0:02:09.88,0:02:10.28,Default,,0,0,0,,valmis,
Dialogue: 0,0:02:10.28,0:02:11.24,Default,,0,0,0,,mä voin hylätä tai
Dialogue: 0,0:02:11.24,0:02:12.72,Default,,0,0,0,,hyväksyä muutoksen,
Dialogue: 0,0:02:12.72,0:02:14.08,Default,,0,0,0,,jatkaa muokkausta käsin,
Dialogue: 0,0:02:14.08,0:02:14.84,Default,,0,0,0,,jatkaa muokkausta
Dialogue: 0,0:02:14.84,0:02:15.64,Default,,0,0,0,,tekoälyn avulla.
Dialogue: 0,0:02:15.64,0:02:16.84,Default,,0,0,0,,Mä voin pyytää myös
Dialogue: 0,0:02:16.84,0:02:18.16,Default,,0,0,0,,tämmöisen analyysin,
Dialogue: 0,0:02:18.16,0:02:19.24,Default,,0,0,0,,mikä kertoo mulle,
Dialogue: 0,0:02:19.24,0:02:20.40,Default,,0,0,0,,että miten mä voisin
Dialogue: 0,0:02:20.40,0:02:21.84,Default,,0,0,0,,parantaa tätä postaustia
Dialogue: 0,0:02:21.84,0:02:22.88,Default,,0,0,0,,entisestään.
Dialogue: 0,0:02:22.88,0:02:23.88,Default,,0,0,0,,Tämä analyysi kertoo
Dialogue: 0,0:02:23.88,0:02:24.88,Default,,0,0,0,,muun muassa minulle,
Dialogue: 0,0:02:24.88,0:02:25.96,Default,,0,0,0,,että vastaako tämä minun
Dialogue: 0,0:02:25.96,0:02:27.80,Default,,0,0,0,,ääniprofiiliin,
Dialogue: 0,0:02:27.80,0:02:29.44,Default,,0,0,0,,onko tämä aloitus vahva
Dialogue: 0,0:02:29.44,0:02:30.40,Default,,0,0,0,,ja tämän tyyppisiä
Dialogue: 0,0:02:30.40,0:02:31.72,Default,,0,0,0,,sisällöllisiä asioita
Dialogue: 0,0:02:31.72,0:02:32.32,Default,,0,0,0,,postauksen
Dialogue: 0,0:02:32.32,0:02:33.32,Default,,0,0,0,,parantamiseen.
Dialogue: 0,0:02:33.32,0:02:34.36,Default,,0,0,0,,Sitten voin valita
Dialogue: 0,0:02:34.36,0:02:35.84,Default,,0,0,0,,täältä jonkun kuvan ja
Dialogue: 0,0:02:35.84,0:02:36.84,Default,,0,0,0,,kun olen valmis,
Dialogue: 0,0:02:36.84,0:02:38.16,Default,,0,0,0,,voin julkaista tämän
Dialogue: 0,0:02:38.16,0:02:40.08,Default,,0,0,0,,postauksen LinkedInissä.
Dialogue: 0,0:02:40.08,0:02:42.32,Default,,0,0,0,,Näin helppoa sisältöjen
Dialogue: 0,0:02:42.32,0:02:43.92,Default,,0,0,0,,luominen on Audivyn
Dialogue: 0,0:02:43.92,0:02:45.84,Default,,0,0,0,,avulla haastattelusta
Dialogue: 0,0:02:45.84,0:02:48.24,Default,,0,0,0,,LinkedInin postauksiksi.
