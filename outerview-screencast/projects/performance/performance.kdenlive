  <property name="kdenlive:sequenceproperties.guides">[
    {
        "comment": "1 face: hello, where I am and what Outerview is about; whole sentence kept (voice continuous, no quiet before \"Tää\")",
        "duration": 0,
        "pos": 0,
        "type": 0
    },
    {
        "comment": "2 face: what Outerview is and that Performance analytics is new; ends before he reaches for the phone",
        "duration": 0,
        "pos": 154,
        "type": 0
    },
    {
        "comment": "3 screen: opening Performance, top posts, basic stats, the growth curve",
        "duration": 0,
        "pos": 625,
        "type": 0
    },
    {
        "comment": "zoom: top posts and the stats row, on \"parhaiten menestyneet postaukset\"",
        "duration": 0,
        "pos": 819,
        "type": 0
    },
    {
        "comment": "zoom: the growth curve's jump, on \"missä kohtaa on otettu meidän oma työkalu käyttöön\"",
        "duration": 0,
        "pos": 1734,
        "type": 0
    },
    {
        "comment": "4 screen: ICP-matching contacts",
        "duration": 0,
        "pos": 1942,
        "type": 0
    },
    {
        "comment": "zoom: Contacts 791 / Possible leads 182, on the ICP explanation",
        "duration": 0,
        "pos": 2165,
        "type": 0
    },
    {
        "comment": "5 screen: how often I post and on what (a 0.8 s pause before it taken out)",
        "duration": 0,
        "pos": 2389,
        "type": 0
    },
    {
        "comment": "6 screen: the AI Analysis tab (the stray sound at 118 taken out)",
        "duration": 0,
        "pos": 2684,
        "type": 0
    },
    {
        "comment": "zoom: the AI summary (\"Your best posts put you inside the scene…\") and +47%",
        "duration": 0,
        "pos": 2778,
        "type": 0
    },
    {
        "comment": "7 screen: the analysis overview (\"Joo totta\" taken out before it); split so its caption matches what's said",
        "duration": 0,
        "pos": 2971,
        "type": 0
    },
    {
        "comment": "8 screen: what works, then the team workspace and the Top lists",
        "duration": 0,
        "pos": 3143,
        "type": 0
    },
    {
        "comment": "zoom: what your best / quiet posts do, on \"tämän tyyppiset sisällöt saa enemmän näyttöjä\"",
        "duration": 0,
        "pos": 3169,
        "type": 0
    },
    {
        "comment": "9 screen: the team leaderboard and the joke; the laugh stays, captioned without the misheard \"Kiitos, että katsoitte\"",
        "duration": 0,
        "pos": 4583,
        "type": 0
    },
    {
        "comment": "zoom: the Leaders podium, on \"koko tiimin vertailu ihmisistä\"",
        "duration": 0,
        "pos": 4609,
        "type": 0
    },
    {
        "comment": "10 screen: Julius gets more comments",
        "duration": 0,
        "pos": 5111,
        "type": 0
    },
    {
        "comment": "zoom: Leaders by Comments, on \"Juliuksen postaukset saa selkeästi enemmän kommentointia\"",
        "duration": 0,
        "pos": 5188,
        "type": 0
    },
    {
        "comment": "11 screen: where the team really is; own segment so the cut-out \"Mun\" doesn't show in a caption",
        "duration": 0,
        "pos": 5610,
        "type": 0
    },
    {
        "comment": "12 screen: Standout posts (the abandoned \"Mun mielestä nämä,\" and the wait taken out before it)",
        "duration": 0,
        "pos": 5684,
        "type": 0
    },
    {
        "comment": "13 face: the wrap-up, closing take 4 (takes 1-3 and the silences taken out)",
        "duration": 0,
        "pos": 5966,
        "type": 0
    }
]
</property>
