Dialogue: 0,00:00:00.00,00:00:00.40,Default,,0,0,0,,Moikka!
Dialogue: 0,00:00:00.40,00:00:01.40,Default,,0,0,0,,Täällä mä oon taas
Dialogue: 0,00:00:01.40,00:00:02.47,Default,,0,0,0,,hapettomassa kopissa
Dialogue: 0,00:00:02.47,00:00:03.20,Default,,0,0,0,,selittämässä,
Dialogue: 0,00:00:03.20,00:00:04.20,Default,,0,0,0,,miten meidän tuote
Dialogue: 0,00:00:04.20,00:00:05.30,Default,,0,0,0,,Outerview toimii.
Dialogue: 0,00:00:05.30,00:00:06.60,Default,,0,0,0,,Tää on siis työkalu,
Dialogue: 0,00:00:06.60,00:00:08.17,Default,,0,0,0,,joka haastattelee meidän
Dialogue: 0,00:00:08.17,00:00:09.70,Default,,0,0,0,,käyttäjiä ja tuottaa sen
Dialogue: 0,00:00:09.70,00:00:10.87,Default,,0,0,0,,pohjalta sisältöjä
Dialogue: 0,00:00:10.87,00:00:12.43,Default,,0,0,0,,esimerkiksi LinkedIniin.
Dialogue: 0,00:00:12.43,00:00:13.73,Default,,0,0,0,,Me on just julkaistu
Dialogue: 0,00:00:13.73,00:00:15.27,Default,,0,0,0,,ihan hiljattain tämmönen
Dialogue: 0,00:00:15.27,00:00:16.07,Default,,0,0,0,,performance,
Dialogue: 0,00:00:16.07,00:00:16.87,Default,,0,0,0,,eli tämmönen
Dialogue: 0,00:00:16.87,00:00:18.13,Default,,0,0,0,,analytiikkatoiminto
Dialogue: 0,00:00:18.13,00:00:18.57,Default,,0,0,0,,tänne,
Dialogue: 0,00:00:18.57,00:00:19.80,Default,,0,0,0,,ja mä näytän vähän,
Dialogue: 0,00:00:19.80,00:00:20.83,Default,,0,0,0,,miten se toimii.
Dialogue: 0,00:00:20.83,00:00:22.17,Default,,0,0,0,,Tää toiminto löytyy
Dialogue: 0,00:00:22.17,00:00:23.33,Default,,0,0,0,,täältä valikosta,
Dialogue: 0,00:00:23.33,00:00:24.77,Default,,0,0,0,,performance-kohdasta,
Dialogue: 0,00:00:24.77,00:00:25.73,Default,,0,0,0,,mennään sinne.
Dialogue: 0,00:00:25.73,00:00:27.07,Default,,0,0,0,,Tässä alussa on mun
Dialogue: 0,00:00:27.07,00:00:28.47,Default,,0,0,0,,parhaiten menestyneet
Dialogue: 0,00:00:28.47,00:00:29.87,Default,,0,0,0,,postaukset viimeisen
Dialogue: 0,00:00:29.87,00:00:31.50,Default,,0,0,0,,kolmen kuukauden ajalta,
Dialogue: 0,00:00:31.50,00:00:32.53,Default,,0,0,0,,ja mä voin toki
Dialogue: 0,00:00:32.53,00:00:33.97,Default,,0,0,0,,valita jonkin muunkin
Dialogue: 0,00:00:33.97,00:00:35.20,Default,,0,0,0,,aikajänteen tänne.
Dialogue: 0,00:00:35.20,00:00:36.83,Default,,0,0,0,,Sit näkyy vähän tämmöstä
Dialogue: 0,00:00:36.83,00:00:38.10,Default,,0,0,0,,perustatistiikkaa,
Dialogue: 0,00:00:38.10,00:00:39.40,Default,,0,0,0,,miten paljon mä oon
Dialogue: 0,00:00:39.40,00:00:40.10,Default,,0,0,0,,postannut,
Dialogue: 0,00:00:40.10,00:00:41.67,Default,,0,0,0,,paljonko mun postauksiin
Dialogue: 0,00:00:41.67,00:00:42.53,Default,,0,0,0,,on reagoitu,
Dialogue: 0,00:00:42.53,00:00:43.70,Default,,0,0,0,,paljonko niitä on
Dialogue: 0,00:00:43.70,00:00:44.57,Default,,0,0,0,,kommentoitu,
Dialogue: 0,00:00:44.57,00:00:45.73,Default,,0,0,0,,ja näin edespäin.
Dialogue: 0,00:00:45.73,00:00:46.97,Default,,0,0,0,,Sit näkyy tämmönen
Dialogue: 0,00:00:46.97,00:00:47.97,Default,,0,0,0,,kumulatiivinen
Dialogue: 0,00:00:47.97,00:00:48.87,Default,,0,0,0,,kehityskäyrä,
Dialogue: 0,00:00:48.87,00:00:50.10,Default,,0,0,0,,ja alhaalla näkyy,
Dialogue: 0,00:00:50.10,00:00:51.17,Default,,0,0,0,,paljonko mä oon
Dialogue: 0,00:00:51.17,00:00:51.87,Default,,0,0,0,,postannut,
Dialogue: 0,00:00:51.87,00:00:52.87,Default,,0,0,0,,ja miten hyvin
Dialogue: 0,00:00:52.87,00:00:53.77,Default,,0,0,0,,reagoinnit ja
Dialogue: 0,00:00:53.77,00:00:54.87,Default,,0,0,0,,kommentoinnit on
Dialogue: 0,00:00:54.87,00:00:55.67,Default,,0,0,0,,kehittynyt.
Dialogue: 0,00:00:55.67,00:00:56.97,Default,,0,0,0,,Täältä käppyrää kun
Dialogue: 0,00:00:56.97,00:00:57.50,Default,,0,0,0,,katsoo,
Dialogue: 0,00:00:57.50,00:00:58.47,Default,,0,0,0,,niin arvatkaa,
Dialogue: 0,00:00:58.47,00:00:59.97,Default,,0,0,0,,missä kohtaa on muuten
Dialogue: 0,00:00:59.97,00:01:01.13,Default,,0,0,0,,otettu meidän oma
Dialogue: 0,00:01:01.13,00:01:02.33,Default,,0,0,0,,työkalu käyttöön,
Dialogue: 0,00:01:02.33,00:01:03.90,Default,,0,0,0,,ettei vaan olisi täällä
Dialogue: 0,00:01:03.90,00:01:04.93,Default,,0,0,0,,tapahtunut.
Dialogue: 0,00:01:04.93,00:01:06.07,Default,,0,0,0,,Sitten meillä on
Dialogue: 0,00:01:06.07,00:01:06.73,Default,,0,0,0,,tämmönen,
Dialogue: 0,00:01:06.73,00:01:08.37,Default,,0,0,0,,tästä mä selitän jossain
Dialogue: 0,00:01:08.37,00:01:09.97,Default,,0,0,0,,toisella videolla vähän
Dialogue: 0,00:01:09.97,00:01:10.53,Default,,0,0,0,,enemmän,
Dialogue: 0,00:01:10.53,00:01:11.73,Default,,0,0,0,,mutta me kerätään
Dialogue: 0,00:01:11.73,00:01:13.10,Default,,0,0,0,,tällaista ideaalisen
Dialogue: 0,00:01:13.10,00:01:14.57,Default,,0,0,0,,asiakkaan profiileja,
Dialogue: 0,00:01:14.57,00:01:15.60,Default,,0,0,0,,tai siis siihen
Dialogue: 0,00:01:15.60,00:01:17.00,Default,,0,0,0,,mätsääviä käyttäjiä,
Dialogue: 0,00:01:17.00,00:01:18.17,Default,,0,0,0,,eli ICP-profiiliin
Dialogue: 0,00:01:18.17,00:01:19.80,Default,,0,0,0,,mätsääviä käyttäjiä.
Dialogue: 0,00:01:19.80,00:01:21.23,Default,,0,0,0,,Siitä tosiaan joskus
Dialogue: 0,00:01:21.23,00:01:22.70,Default,,0,0,0,,vähän myöhemmin näkee
Dialogue: 0,00:01:22.70,00:01:24.00,Default,,0,0,0,,pikkasen käppyrää,
Dialogue: 0,00:01:24.00,00:01:25.33,Default,,0,0,0,,että miten usein mä
Dialogue: 0,00:01:25.33,00:01:25.93,Default,,0,0,0,,postaan,
Dialogue: 0,00:01:25.93,00:01:27.10,Default,,0,0,0,,ja sitten vähän,
Dialogue: 0,00:01:27.10,00:01:28.57,Default,,0,0,0,,mistä aiheesta mä oon
Dialogue: 0,00:01:28.57,00:01:29.47,Default,,0,0,0,,postannut.
Dialogue: 0,00:01:29.47,00:01:30.30,Default,,0,0,0,,Täällä on myös tällainen
Dialogue: 0,00:01:30.30,00:01:31.17,Default,,0,0,0,,analyysinäkymä,
Dialogue: 0,00:01:31.17,00:01:32.40,Default,,0,0,0,,eli sitten analysoidaan
Dialogue: 0,00:01:32.40,00:01:33.57,Default,,0,0,0,,niitä mun postauksia,
Dialogue: 0,00:01:33.57,00:01:34.80,Default,,0,0,0,,miten ne on menestynyt,
Dialogue: 0,00:01:34.80,00:01:36.10,Default,,0,0,0,,minkä tyyppiset sisällöt
Dialogue: 0,00:01:36.10,00:01:36.53,Default,,0,0,0,,toimii,
Dialogue: 0,00:01:36.53,00:01:37.83,Default,,0,0,0,,minkä tyyppiset sisällöt
Dialogue: 0,00:01:37.83,00:01:38.37,Default,,0,0,0,,ei toimi.
Dialogue: 0,00:01:38.37,00:01:39.33,Default,,0,0,0,,Tuossa on tämmönen
Dialogue: 0,00:01:39.33,00:01:39.90,Default,,0,0,0,,yleiskuva,
Dialogue: 0,00:01:39.90,00:01:41.10,Default,,0,0,0,,ja jos laittaa itsensä
Dialogue: 0,00:01:41.10,00:01:42.27,Default,,0,0,0,,niin sanotusti peliin,
Dialogue: 0,00:01:42.27,00:01:43.47,Default,,0,0,0,,niin se yleensä toimii
Dialogue: 0,00:01:43.47,00:01:44.07,Default,,0,0,0,,paremmin.
Dialogue: 0,00:01:44.07,00:01:45.27,Default,,0,0,0,,Sitten täällä on
Dialogue: 0,00:01:45.27,00:01:45.90,Default,,0,0,0,,silleen,
Dialogue: 0,00:01:45.90,00:01:47.47,Default,,0,0,0,,että nämä sisällöt on
Dialogue: 0,00:01:47.47,00:01:48.20,Default,,0,0,0,,toiminut,
Dialogue: 0,00:01:48.20,00:01:49.97,Default,,0,0,0,,tämän tyyppiset sisällöt
Dialogue: 0,00:01:49.97,00:01:51.53,Default,,0,0,0,,saa enemmän näyttöjä,
Dialogue: 0,00:01:51.53,00:01:53.17,Default,,0,0,0,,sitten tämän tyyppiset
Dialogue: 0,00:01:53.17,00:01:54.67,Default,,0,0,0,,sisällöt ei saa yhtä
Dialogue: 0,00:01:54.67,00:01:55.80,Default,,0,0,0,,hyvin näyttöjä.
Dialogue: 0,00:01:55.80,00:01:56.67,Default,,0,0,0,,Tämä toimii
Dialogue: 0,00:01:56.67,00:01:58.03,Default,,0,0,0,,henkilökohtaisella
Dialogue: 0,00:01:58.03,00:01:58.73,Default,,0,0,0,,puolella,
Dialogue: 0,00:01:58.73,00:02:00.10,Default,,0,0,0,,mutta sitten myös,
Dialogue: 0,00:02:00.10,00:02:01.37,Default,,0,0,0,,jos on tiimipuoli
Dialogue: 0,00:02:01.37,00:02:02.10,Default,,0,0,0,,käytössä,
Dialogue: 0,00:02:02.10,00:02:03.60,Default,,0,0,0,,mä otan tämän meidän
Dialogue: 0,00:02:03.60,00:02:05.07,Default,,0,0,0,,tiimin performancen,
Dialogue: 0,00:02:05.07,00:02:05.63,Default,,0,0,0,,tämä on
Dialogue: 0,00:02:05.63,00:02:06.93,Default,,0,0,0,,mielenkiintoinen.
Dialogue: 0,00:02:06.93,00:02:08.63,Default,,0,0,0,,Me nähdään vähän samoja
Dialogue: 0,00:02:08.63,00:02:09.27,Default,,0,0,0,,juttuja,
Dialogue: 0,00:02:09.27,00:02:10.50,Default,,0,0,0,,kuin mitä tuolla
Dialogue: 0,00:02:10.50,00:02:11.87,Default,,0,0,0,,henkilökohtaisella
Dialogue: 0,00:02:11.87,00:02:12.57,Default,,0,0,0,,puolella,
Dialogue: 0,00:02:12.57,00:02:13.83,Default,,0,0,0,,nyt niinku tiimin
Dialogue: 0,00:02:13.83,00:02:14.50,Default,,0,0,0,,tasolla,
Dialogue: 0,00:02:14.50,00:02:16.00,Default,,0,0,0,,että paljonko meidän
Dialogue: 0,00:02:16.00,00:02:17.77,Default,,0,0,0,,tiimi on tänne postannut
Dialogue: 0,00:02:17.77,00:02:18.63,Default,,0,0,0,,linkkariin,
Dialogue: 0,00:02:18.63,00:02:20.03,Default,,0,0,0,,ja miten ihmiset on
Dialogue: 0,00:02:20.03,00:02:21.47,Default,,0,0,0,,niihin reagoinut ja
Dialogue: 0,00:02:21.47,00:02:21.97,Default,,0,0,0,,muuta,
Dialogue: 0,00:02:21.97,00:02:23.27,Default,,0,0,0,,postausten määrä.
Dialogue: 0,00:02:23.27,00:02:24.83,Default,,0,0,0,,Mutta sitten kaikista
Dialogue: 0,00:02:24.83,00:02:25.47,Default,,0,0,0,,tärkein,
Dialogue: 0,00:02:25.47,00:02:27.10,Default,,0,0,0,,koska kilpailu motivoi
Dialogue: 0,00:02:27.10,00:02:28.30,Default,,0,0,0,,ainakin joitakin
Dialogue: 0,00:02:28.30,00:02:28.97,Default,,0,0,0,,ihmisiä,
Dialogue: 0,00:02:28.97,00:02:30.60,Default,,0,0,0,,niin sittenhän nähdään
Dialogue: 0,00:02:30.60,00:02:32.30,Default,,0,0,0,,myös toplistoja.
Dialogue: 0,00:02:32.30,00:02:33.67,Default,,0,0,0,,Ja tämähän on koko
Dialogue: 0,00:02:33.67,00:02:34.83,Default,,0,0,0,,tiimin vertailu
Dialogue: 0,00:02:34.83,00:02:35.67,Default,,0,0,0,,ihmisistä,
Dialogue: 0,00:02:35.67,00:02:36.60,Default,,0,0,0,,ja mä en tee
Dialogue: 0,00:02:36.60,00:02:38.20,Default,,0,0,0,,tätä videota tietysti
Dialogue: 0,00:02:38.20,00:02:38.73,Default,,0,0,0,,siksi,
Dialogue: 0,00:02:38.73,00:02:40.03,Default,,0,0,0,,että mä voin itse
Dialogue: 0,00:02:40.03,00:02:40.93,Default,,0,0,0,,olla täällä
Dialogue: 0,00:02:40.93,00:02:42.00,Default,,0,0,0,,ykköspaikalla,
Dialogue: 0,00:02:42.00,00:02:43.33,Default,,0,0,0,,mutta no ei vitsi
Dialogue: 0,00:02:43.33,00:02:43.83,Default,,0,0,0,,vitsi,
Dialogue: 0,00:02:43.83,00:02:45.30,Default,,0,0,0,,nähdään paljonko on
Dialogue: 0,00:02:45.30,00:02:46.03,Default,,0,0,0,,postattu,
Dialogue: 0,00:02:46.03,00:02:47.67,Default,,0,0,0,,paljonko on reagoitu,
Dialogue: 0,00:02:47.67,00:02:49.67,Default,,0,0,0,,paljonko on kommentoitu.
Dialogue: 0,00:02:49.67,00:02:51.13,Default,,0,0,0,,Tässä on tämmönen hauska
Dialogue: 0,00:02:51.13,00:02:51.57,Default,,0,0,0,,juttu,
Dialogue: 0,00:02:51.57,00:02:52.47,Default,,0,0,0,,että Juliuksen
Dialogue: 0,00:02:52.47,00:02:53.93,Default,,0,0,0,,postaukset saa selkeästi
Dialogue: 0,00:02:53.93,00:02:55.30,Default,,0,0,0,,enemmän kommentointia,
Dialogue: 0,00:02:55.30,00:02:56.37,Default,,0,0,0,,kuin meikäläisen.
Dialogue: 0,00:02:56.37,00:02:56.87,Default,,0,0,0,,No joo,
Dialogue: 0,00:02:56.87,00:02:57.87,Default,,0,0,0,,pystyy tämmösiin
Dialogue: 0,00:02:57.87,00:02:58.87,Default,,0,0,0,,juttuihin täällä
Dialogue: 0,00:02:58.87,00:02:59.67,Default,,0,0,0,,kaivelemaan.
Dialogue: 0,00:02:59.67,00:03:00.50,Default,,0,0,0,,Ehkä just se,
Dialogue: 0,00:03:00.50,00:03:01.43,Default,,0,0,0,,että jos vaikka
Dialogue: 0,00:03:01.43,00:03:02.43,Default,,0,0,0,,systemaattisesti
Dialogue: 0,00:03:02.43,00:03:03.50,Default,,0,0,0,,LinkedInin tekee,
Dialogue: 0,00:03:03.50,00:03:05.50,Default,,0,0,0,,niin tähän sitten näkee,
Dialogue: 0,00:03:06.43,00:03:08.13,Default,,0,0,0,,että missä me oikeasti
Dialogue: 0,00:03:08.13,00:03:08.80,Default,,0,0,0,,mennään.
Dialogue: 0,00:03:08.80,00:03:10.10,Default,,0,0,0,,Ja sitten täältä pääsee
Dialogue: 0,00:03:10.10,00:03:10.100,Default,,0,0,0,,sukeltaan vielä
Dialogue: 0,00:03:11.00,00:03:12.23,Default,,0,0,0,,yksityiskohtaisemmin,
Dialogue: 0,00:03:12.23,00:03:13.50,Default,,0,0,0,,täältä yksittäisiinkin
Dialogue: 0,00:03:13.50,00:03:14.23,Default,,0,0,0,,postauksiin,
Dialogue: 0,00:03:14.23,00:03:15.23,Default,,0,0,0,,näkee miten ne on
Dialogue: 0,00:03:15.23,00:03:16.60,Default,,0,0,0,,toiminut ja minkä tyyppi
Dialogue: 0,00:03:16.60,00:03:18.20,Default,,0,0,0,,sitten on toiminut näin.
Dialogue: 0,00:03:18.20,00:03:19.33,Default,,0,0,0,,Mun mielestä nämä
Dialogue: 0,00:03:19.33,00:03:19.90,Default,,0,0,0,,näkymät,
Dialogue: 0,00:03:19.90,00:03:21.33,Default,,0,0,0,,vaikka itse
Dialogue: 0,00:03:21.33,00:03:21.97,Default,,0,0,0,,sanonkin,
Dialogue: 0,00:03:21.97,00:03:23.07,Default,,0,0,0,,on parempia kuin
Dialogue: 0,00:03:23.07,00:03:24.10,Default,,0,0,0,,LinkedInin omat
Dialogue: 0,00:03:24.10,00:03:25.37,Default,,0,0,0,,analytiikkanäkymät,
Dialogue: 0,00:03:25.37,00:03:26.40,Default,,0,0,0,,ja täältä niitä
Dialogue: 0,00:03:26.40,00:03:27.77,Default,,0,0,0,,Outerviewn uumenista
Dialogue: 0,00:03:27.77,00:03:28.07,Default,,0,0,0,,saa,
Dialogue: 0,00:03:28.07,00:03:29.10,Default,,0,0,0,,jos kiinnostaa.
Dialogue: 0,00:03:29.10,00:03:30.63,Default,,0,0,0,,Oman tuotteen kehuminen
Dialogue: 0,00:03:30.63,00:03:31.77,Default,,0,0,0,,päättyy tähän.
