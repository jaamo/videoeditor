{
  "name": "outerview-videos",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "make": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/cli.ts",
    "studio": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/cli.ts --studio",
    "check": "tsc",
    "shot": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/shot.ts",
    "say": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/say.ts",
    "transcribe": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/screencast/transcribe.ts",
    "cut": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/screencast/cut.ts",
    "clicks": "python3 src/screencast/click-circles.py",
    "titles": "remotion studio src/remotion/index.ts --public-dir=assets/titles",
    "titles:render": "remotion render src/remotion/index.ts Intro out/titles/intro.mp4 --public-dir=assets/titles && remotion render src/remotion/index.ts End out/titles/end.mp4 --public-dir=assets/titles",
    "new": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/screencast/new.ts",
    "video": "node --env-file=.env --disable-warning=DEP0205 --import=tsx src/video/cli.ts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/install-whisper-cpp": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.536",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "private": true
}
