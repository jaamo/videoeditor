Dialogue: 0,0:00:00.00,0:00:01.12,Default,,0,0,0,,Moikka!
Dialogue: 0,0:00:01.26,0:00:01.80,Default,,0,0,0,,Koitan nyt kertoa
Dialogue: 0,0:00:01.80,0:00:03.64,Default,,0,0,0,,kahdessa minuutissa,
Dialogue: 0,0:00:03.64,0:00:04.36,Default,,0,0,0,,mikä on tämä tuote,
Dialogue: 0,0:00:04.36,0:00:05.70,Default,,0,0,0,,mitä me kehitetään,
Dialogue: 0,0:00:05.70,0:00:06.92,Default,,0,0,0,,eli Outerview.
Dialogue: 0,0:00:06.92,0:00:07.26,Default,,0,0,0,,En tiedä,
Dialogue: 0,0:00:07.26,0:00:07.64,Default,,0,0,0,,meneekö tämä siellä
Dialogue: 0,0:00:07.64,0:00:08.50,Default,,0,0,0,,kaksi minuuttia,
Dialogue: 0,0:00:08.50,0:00:10.42,Default,,0,0,0,,mutta katsotaan.
Dialogue: 0,0:00:10.42,0:00:11.20,Default,,0,0,0,,Homma lähtee siitä,
Dialogue: 0,0:00:11.20,0:00:12.30,Default,,0,0,0,,että kun tänne kirjautuu
Dialogue: 0,0:00:12.30,0:00:13.30,Default,,0,0,0,,sisään,
Dialogue: 0,0:00:13.30,0:00:14.38,Default,,0,0,0,,niin käydään sellainen
Dialogue: 0,0:00:14.38,0:00:15.34,Default,,0,0,0,,haastattelu,
Dialogue: 0,0:00:15.34,0:00:16.02,Default,,0,0,0,,jonka pohjalta
Dialogue: 0,0:00:16.02,0:00:18.10,Default,,0,0,0,,käyttäjälle luodaan
Dialogue: 0,0:00:18.10,0:00:19.36,Default,,0,0,0,,strategia.
Dialogue: 0,0:00:19.58,0:00:20.16,Default,,0,0,0,,Jos haluaa tehdä
Dialogue: 0,0:00:20.16,0:00:21.10,Default,,0,0,0,,säännöllisesti lisää
Dialogue: 0,0:00:21.10,0:00:23.02,Default,,0,0,0,,sisältöä LinkedIniin ja
Dialogue: 0,0:00:23.02,0:00:23.74,Default,,0,0,0,,ehkä jollain tavalla
Dialogue: 0,0:00:23.74,0:00:25.04,Default,,0,0,0,,onnistuukin siinä,
Dialogue: 0,0:00:25.04,0:00:26.12,Default,,0,0,0,,niin pitää miettiä,
Dialogue: 0,0:00:26.12,0:00:26.82,Default,,0,0,0,,mistä asioista haluaa
Dialogue: 0,0:00:26.82,0:00:28.10,Default,,0,0,0,,tulla tunnetuksi,
Dialogue: 0,0:00:28.10,0:00:29.08,Default,,0,0,0,,kenelle sitä tekee,
Dialogue: 0,0:00:29.08,0:00:31.50,Default,,0,0,0,,miten usein postaa,
Dialogue: 0,0:00:32.12,0:00:33.64,Default,,0,0,0,,mitä haluaa tavoitella,
Dialogue: 0,0:00:33.64,0:00:34.36,Default,,0,0,0,,miltä ei halua
Dialogue: 0,0:00:34.36,0:00:35.62,Default,,0,0,0,,kuulostaa.
Dialogue: 0,0:00:35.62,0:00:37.22,Default,,0,0,0,,Tämän tyyppisiä asioita,
Dialogue: 0,0:00:37.22,0:00:38.00,Default,,0,0,0,,sellaisen
Dialogue: 0,0:00:38.00,0:00:38.98,Default,,0,0,0,,ennakkohaastattelun
Dialogue: 0,0:00:38.98,0:00:40.76,Default,,0,0,0,,perusteella me luodaan
Dialogue: 0,0:00:40.76,0:00:42.86,Default,,0,0,0,,tänne tämä strategia.
Dialogue: 0,0:00:42.92,0:00:43.64,Default,,0,0,0,,Tämän strategian
Dialogue: 0,0:00:43.64,0:00:46.46,Default,,0,0,0,,pohjalta syntyy teemoja,
Dialogue: 0,0:00:46.46,0:00:47.74,Default,,0,0,0,,eli erilaisia teemoja,
Dialogue: 0,0:00:47.74,0:00:49.80,Default,,0,0,0,,mistä minä haluan puhua.
Dialogue: 0,0:00:49.92,0:00:50.62,Default,,0,0,0,,Täällä on minulle vaikka
Dialogue: 0,0:00:50.62,0:00:52.26,Default,,0,0,0,,agenttinen kehitys ja
Dialogue: 0,0:00:52.26,0:00:53.68,Default,,0,0,0,,tekoäly käytännössä tai
Dialogue: 0,0:00:53.68,0:00:55.32,Default,,0,0,0,,teknologia tai luovuus
Dialogue: 0,0:00:55.32,0:00:56.68,Default,,0,0,0,,tai niin kuin tämän
Dialogue: 0,0:00:56.68,0:00:58.22,Default,,0,0,0,,tyyppisiä asioita.
Dialogue: 0,0:00:58.46,0:00:59.18,Default,,0,0,0,,Minä voin luoda tänne
Dialogue: 0,0:00:59.18,0:01:00.66,Default,,0,0,0,,koskaan uusia teemoja
Dialogue: 0,0:01:00.66,0:01:01.78,Default,,0,0,0,,tai minä voin poistaa
Dialogue: 0,0:01:01.78,0:01:02.76,Default,,0,0,0,,näitä olemassa olevia
Dialogue: 0,0:01:02.76,0:01:03.84,Default,,0,0,0,,järjestelmällä,
Dialogue: 0,0:01:03.84,0:01:04.38,Default,,0,0,0,,mitä minä ikinä
Dialogue: 0,0:01:04.38,0:01:05.70,Default,,0,0,0,,haluankaan tehdä siitä
Dialogue: 0,0:01:05.70,0:01:06.90,Default,,0,0,0,,hienosaa tai just
Dialogue: 0,0:01:06.90,0:01:09.18,Default,,0,0,0,,sellaisen kuin minä
Dialogue: 0,0:01:09.18,0:01:09.98,Default,,0,0,0,,haluan.
Dialogue: 0,0:01:09.98,0:01:11.68,Default,,0,0,0,,Näiden teemojen pohjalta
Dialogue: 0,0:01:11.68,0:01:14.70,Default,,0,0,0,,syntyy sitten ideoita.
Dialogue: 0,0:01:14.70,0:01:15.56,Default,,0,0,0,,Eli totta kai tänne
Dialogue: 0,0:01:15.56,0:01:17.04,Default,,0,0,0,,voi syöksyä vaan ja
Dialogue: 0,0:01:17.04,0:01:17.72,Default,,0,0,0,,ruveta tekemään omia
Dialogue: 0,0:01:17.72,0:01:18.62,Default,,0,0,0,,ideoitaan,
Dialogue: 0,0:01:18.62,0:01:19.74,Default,,0,0,0,,mutta sitten on paljon
Dialogue: 0,0:01:19.74,0:01:21.36,Default,,0,0,0,,tai usein on sellaista,
Dialogue: 0,0:01:21.36,0:01:22.38,Default,,0,0,0,,että ei oikein tiedä
Dialogue: 0,0:01:22.38,0:01:24.36,Default,,0,0,0,,mistä postaisi,
Dialogue: 0,0:01:24.36,0:01:25.38,Default,,0,0,0,,niin sitten tämä
Dialogue: 0,0:01:25.38,0:01:25.86,Default,,0,0,0,,aikaisempien
Dialogue: 0,0:01:25.86,0:01:27.02,Default,,0,0,0,,keskusteluiden pohjalta
Dialogue: 0,0:01:27.02,0:01:27.70,Default,,0,0,0,,ja sen pohjalta,
Dialogue: 0,0:01:27.70,0:01:29.10,Default,,0,0,0,,mitä me tiedetään ja
Dialogue: 0,0:01:29.10,0:01:29.86,Default,,0,0,0,,muuten,
Dialogue: 0,0:01:29.86,0:01:30.94,Default,,0,0,0,,niin luo näitä uusia
Dialogue: 0,0:01:30.94,0:01:31.50,Default,,0,0,0,,ideoita.
Dialogue: 0,0:01:31.50,0:01:32.70,Default,,0,0,0,,Esimerkiksi täällä on,
Dialogue: 0,0:01:32.70,0:01:33.42,Default,,0,0,0,,että 15 vuoden
Dialogue: 0,0:01:33.42,0:01:34.86,Default,,0,0,0,,agency-elämän jälkeen
Dialogue: 0,0:01:34.86,0:01:35.94,Default,,0,0,0,,nyt kokeillaan omien
Dialogue: 0,0:01:35.94,0:01:37.58,Default,,0,0,0,,tuotteiden rakentamista.
Dialogue: 0,0:01:38.12,0:01:39.40,Default,,0,0,0,,Ja tällaisia osahan
Dialogue: 0,0:01:39.40,0:01:40.54,Default,,0,0,0,,näistä on jo huonoja.
Dialogue: 0,0:01:40.54,0:01:41.14,Default,,0,0,0,,Sitten minä voin niitä
Dialogue: 0,0:01:41.14,0:01:42.92,Default,,0,0,0,,täältä poistaa tai
Dialogue: 0,0:01:42.92,0:01:43.60,Default,,0,0,0,,sitten minä voin lisätä
Dialogue: 0,0:01:43.60,0:01:44.92,Default,,0,0,0,,tänne omiin.
Dialogue: 0,0:01:45.04,0:01:46.72,Default,,0,0,0,,Minä voin lähteä jostain
Dialogue: 0,0:01:46.72,0:01:47.68,Default,,0,0,0,,tällaisesta ja pyytää
Dialogue: 0,0:01:47.68,0:01:48.76,Default,,0,0,0,,sitten keskustelussa,
Dialogue: 0,0:01:48.76,0:01:49.16,Default,,0,0,0,,että mennäänkö vähän
Dialogue: 0,0:01:49.16,0:01:50.12,Default,,0,0,0,,toiseen suuntaan.
Dialogue: 0,0:01:50.12,0:01:51.40,Default,,0,0,0,,Minä lisän tämän nyt
Dialogue: 0,0:01:51.40,0:01:53.96,Default,,0,0,0,,oman idean ja minä
Dialogue: 0,0:01:53.96,0:01:54.58,Default,,0,0,0,,haluan lähteä nyt
Dialogue: 0,0:01:54.58,0:01:55.36,Default,,0,0,0,,tällaisesta ideasta
Dialogue: 0,0:01:55.36,0:01:56.16,Default,,0,0,0,,liikkeelle,
Dialogue: 0,0:01:56.16,0:01:57.06,Default,,0,0,0,,kun miksi tekoäly teki
Dialogue: 0,0:01:57.06,0:01:57.96,Default,,0,0,0,,suunnittelijoista hyviä
Dialogue: 0,0:01:57.96,0:01:58.74,Default,,0,0,0,,koodaajia,
Dialogue: 0,0:01:58.74,0:02:00.68,Default,,0,0,0,,mutta ei toisinpäin.
Dialogue: 0,0:02:00.68,0:02:01.14,Default,,0,0,0,,Lähdetään täältä
Dialogue: 0,0:02:01.14,0:02:02.42,Default,,0,0,0,,haastatteluun.
Dialogue: 0,0:02:02.78,0:02:04.26,Default,,0,0,0,,Tämä haastattelu on koko
Dialogue: 0,0:02:04.26,0:02:06.54,Default,,0,0,0,,Outerviewn mielestäni
Dialogue: 0,0:02:06.54,0:02:08.14,Default,,0,0,0,,hienoin juttu.
Dialogue: 0,0:02:08.14,0:02:08.64,Default,,0,0,0,,Idean on se,
Dialogue: 0,0:02:08.64,0:02:09.74,Default,,0,0,0,,että me mennään tästä
Dialogue: 0,0:02:09.74,0:02:11.00,Default,,0,0,0,,haastatteluun.
Dialogue: 0,0:02:11.88,0:02:12.80,Default,,0,0,0,,Moikka Jaakko,
Dialogue: 0,0:02:12.80,0:02:13.72,Default,,0,0,0,,mennään suoraan siihen,
Dialogue: 0,0:02:13.72,0:02:14.06,Default,,0,0,0,,mitä sinulla oli
Dialogue: 0,0:02:14.06,0:02:14.98,Default,,0,0,0,,mielessä.
Dialogue: 0,0:02:15.14,0:02:15.90,Default,,0,0,0,,Sinä olet paljon
Dialogue: 0,0:02:15.90,0:02:16.96,Default,,0,0,0,,teknologian parissa,
Dialogue: 0,0:02:16.96,0:02:18.06,Default,,0,0,0,,niin miten sinä itse
Dialogue: 0,0:02:18.06,0:02:19.16,Default,,0,0,0,,näet tämän asymetrian?
Dialogue: 0,0:02:19.16,0:02:21.16,Default,,0,0,0,,Miksi tekoäly auttaa
Dialogue: 0,0:02:21.16,0:02:22.30,Default,,0,0,0,,koodaamisessa eri
Dialogue: 0,0:02:22.30,0:02:22.74,Default,,0,0,0,,tavalla kuin
Dialogue: 0,0:02:22.74,0:02:23.98,Default,,0,0,0,,suunnittelussa?
Dialogue: 0,0:02:24.08,0:02:25.14,Default,,0,0,0,,Minä voin nyt
Dialogue: 0,0:02:25.14,0:02:26.14,Default,,0,0,0,,keskustella tämän
Dialogue: 0,0:02:26.14,0:02:27.54,Default,,0,0,0,,agentin kanssa.
Dialogue: 0,0:02:27.56,0:02:28.14,Default,,0,0,0,,Tämä keskustelu
Dialogue: 0,0:02:28.14,0:02:30.64,Default,,0,0,0,,pohjautuu kaikkeen
Dialogue: 0,0:02:30.64,0:02:31.14,Default,,0,0,0,,siihen,
Dialogue: 0,0:02:31.14,0:02:32.38,Default,,0,0,0,,mitä minusta tiedetään,
Dialogue: 0,0:02:32.38,0:02:33.06,Default,,0,0,0,,eli aikaisempiin
Dialogue: 0,0:02:33.06,0:02:34.16,Default,,0,0,0,,haastatteluihin,
Dialogue: 0,0:02:34.16,0:02:35.28,Default,,0,0,0,,strategiaan ja minun
Dialogue: 0,0:02:35.28,0:02:36.46,Default,,0,0,0,,tekemiin postauksiin ja
Dialogue: 0,0:02:36.46,0:02:37.48,Default,,0,0,0,,ideoihin.
Dialogue: 0,0:02:38.10,0:02:39.14,Default,,0,0,0,,Se oppii niistä ja
Dialogue: 0,0:02:39.14,0:02:39.66,Default,,0,0,0,,kehittyy.
Dialogue: 0,0:02:39.66,0:02:40.90,Default,,0,0,0,,Tämän idean se,
Dialogue: 0,0:02:41.20,0:02:42.56,Default,,0,0,0,,että tässä keskustelussa
Dialogue: 0,0:02:42.56,0:02:44.34,Default,,0,0,0,,tämä yrittää haastaa
Dialogue: 0,0:02:44.34,0:02:46.32,Default,,0,0,0,,minua löytämään jotain
Dialogue: 0,0:02:46.32,0:02:47.14,Default,,0,0,0,,uutta,
Dialogue: 0,0:02:47.14,0:02:48.22,Default,,0,0,0,,ideoimaan,
Dialogue: 0,0:02:48.22,0:02:48.64,Default,,0,0,0,,saamaan jotain
Dialogue: 0,0:02:48.64,0:02:49.58,Default,,0,0,0,,aikaiseksi.
Dialogue: 0,0:02:49.58,0:02:51.16,Default,,0,0,0,,Sen perusteella sitten
Dialogue: 0,0:02:51.16,0:02:52.26,Default,,0,0,0,,lähdetään luomaan siitä
Dialogue: 0,0:02:52.26,0:02:53.70,Default,,0,0,0,,sisältöä.
Dialogue: 0,0:02:53.70,0:02:54.50,Default,,0,0,0,,Vastataan nyt tästä
Dialogue: 0,0:02:54.50,0:02:55.60,Default,,0,0,0,,jotakin Mayalle,
Dialogue: 0,0:02:55.60,0:02:57.00,Default,,0,0,0,,kun se kerran odottaa.
Dialogue: 0,0:02:57.26,0:02:57.44,Default,,0,0,0,,Joo,
Dialogue: 0,0:02:57.44,0:02:58.02,Default,,0,0,0,,minä jäin miettimään
Dialogue: 0,0:02:58.02,0:02:58.94,Default,,0,0,0,,sellaista,
Dialogue: 0,0:02:59.28,0:03:00.90,Default,,0,0,0,,että minusta tuntuu,
Dialogue: 0,0:03:00.90,0:03:02.18,Default,,0,0,0,,että aika moni
Dialogue: 0,0:03:02.18,0:03:03.06,Default,,0,0,0,,suunnittelija on tullut
Dialogue: 0,0:03:03.06,0:03:03.80,Default,,0,0,0,,sinne kehittäjän
Dialogue: 0,0:03:03.80,0:03:04.24,Default,,0,0,0,,tontille,
Dialogue: 0,0:03:04.24,0:03:05.30,Default,,0,0,0,,eli minun tontille,
Dialogue: 0,0:03:05.30,0:03:06.58,Default,,0,0,0,,mutta itse kehittäjänä
Dialogue: 0,0:03:06.58,0:03:08.06,Default,,0,0,0,,minun on vaikea mennä
Dialogue: 0,0:03:08.06,0:03:08.92,Default,,0,0,0,,sinne suunnittelijan
Dialogue: 0,0:03:08.92,0:03:09.42,Default,,0,0,0,,tontille,
Dialogue: 0,0:03:09.42,0:03:10.62,Default,,0,0,0,,koska tekoäly ei auta
Dialogue: 0,0:03:10.62,0:03:11.14,Default,,0,0,0,,minua siinä
Dialogue: 0,0:03:11.14,0:03:12.02,Default,,0,0,0,,suunnittelutyössä niin
Dialogue: 0,0:03:12.02,0:03:12.42,Default,,0,0,0,,paljon.
Dialogue: 0,0:03:12.42,0:03:12.74,Default,,0,0,0,,Minä olen huomannut
Dialogue: 0,0:03:12.74,0:03:13.24,Default,,0,0,0,,tämmöisen.
Dialogue: 0,0:03:13.24,0:03:15.22,Default,,0,0,0,,Aika kova havainto.
Dialogue: 0,0:03:15.36,0:03:16.12,Default,,0,0,0,,Miten suunnittelijat ja
Dialogue: 0,0:03:16.12,0:03:17.30,Default,,0,0,0,,kehittäjät sun ympärillä
Dialogue: 0,0:03:17.30,0:03:18.24,Default,,0,0,0,,yleensä suhtautuvat
Dialogue: 0,0:03:18.24,0:03:19.90,Default,,0,0,0,,tähän epäsymmetriaan?
Dialogue: 0,0:03:19.90,0:03:20.36,Default,,0,0,0,,Minä en nyt höpise
Dialogue: 0,0:03:20.36,0:03:21.62,Default,,0,0,0,,tämän kanssa enempää,
Dialogue: 0,0:03:21.62,0:03:22.46,Default,,0,0,0,,koska siinä menisi ikeä
Dialogue: 0,0:03:22.46,0:03:23.08,Default,,0,0,0,,ja terveys.
Dialogue: 0,0:03:23.08,0:03:23.86,Default,,0,0,0,,Lopetellaan tämä,
Dialogue: 0,0:03:23.86,0:03:24.76,Default,,0,0,0,,mennään luomaan
Dialogue: 0,0:03:24.76,0:03:26.20,Default,,0,0,0,,sisältöä.
Dialogue: 0,0:03:26.20,0:03:26.98,Default,,0,0,0,,Haastattelun jälkeen
Dialogue: 0,0:03:26.98,0:03:27.82,Default,,0,0,0,,muut kysytään,
Dialogue: 0,0:03:27.82,0:03:28.70,Default,,0,0,0,,että haluatko minä tehdä
Dialogue: 0,0:03:28.70,0:03:30.02,Default,,0,0,0,,linkkaripostauksia vai
Dialogue: 0,0:03:30.02,0:03:30.68,Default,,0,0,0,,haluatko minä tehdä
Dialogue: 0,0:03:30.68,0:03:31.84,Default,,0,0,0,,artikkeleita esimerkiksi
Dialogue: 0,0:03:31.84,0:03:32.90,Default,,0,0,0,,blogiin.
Dialogue: 0,0:03:32.90,0:03:33.18,Default,,0,0,0,,Lähdetään tekemään
Dialogue: 0,0:03:33.18,0:03:34.84,Default,,0,0,0,,linkkaripostauksia.
Dialogue: 0,0:03:35.16,0:03:35.90,Default,,0,0,0,,Tuon keskustelun
Dialogue: 0,0:03:35.90,0:03:37.00,Default,,0,0,0,,pohjalta sieltä
Dialogue: 0,0:03:37.00,0:03:38.52,Default,,0,0,0,,kaivetaan aihioita,
Dialogue: 0,0:03:38.52,0:03:39.56,Default,,0,0,0,,postausaihioita.
Dialogue: 0,0:03:39.56,0:03:40.42,Default,,0,0,0,,Nyt oli sen verran
Dialogue: 0,0:03:40.42,0:03:41.72,Default,,0,0,0,,hyvä haastattelu,
Dialogue: 0,0:03:41.74,0:03:42.30,Default,,0,0,0,,että sieltä tuli vain
Dialogue: 0,0:03:42.30,0:03:43.46,Default,,0,0,0,,yksi aihio.
Dialogue: 0,0:03:43.46,0:03:43.98,Default,,0,0,0,,Lähdetään luomaan
Dialogue: 0,0:03:43.98,0:03:44.78,Default,,0,0,0,,postausta sen
Dialogue: 0,0:03:44.78,0:03:46.98,Default,,0,0,0,,perusteella mun äänellä.
Dialogue: 0,0:03:46.98,0:03:47.54,Default,,0,0,0,,Voitaisiin tehdä myös
Dialogue: 0,0:03:47.54,0:03:49.10,Default,,0,0,0,,firman äänellä.
Dialogue: 0,0:03:49.68,0:03:51.38,Default,,0,0,0,,Valitaan kieli tuettuina
Dialogue: 0,0:03:51.38,0:03:51.90,Default,,0,0,0,,englanti,
Dialogue: 0,0:03:51.90,0:03:52.20,Default,,0,0,0,,suomi,
Dialogue: 0,0:03:52.20,0:03:53.02,Default,,0,0,0,,ruotsi tällä hetkellä.
Dialogue: 0,0:03:53.02,0:03:54.12,Default,,0,0,0,,Tehdään suomeksi.
Dialogue: 0,0:03:54.12,0:03:54.64,Default,,0,0,0,,Lähdetään generoimaan
Dialogue: 0,0:03:54.64,0:03:56.26,Default,,0,0,0,,postausta tuosta.
Dialogue: 0,0:03:56.80,0:03:58.24,Default,,0,0,0,,Postauksen ensimmäinen
Dialogue: 0,0:03:58.24,0:04:00.10,Default,,0,0,0,,versio on nyt valmis.
Dialogue: 0,0:04:00.20,0:04:00.90,Default,,0,0,0,,Ja niin kuin tekoälyn
Dialogue: 0,0:04:00.90,0:04:02.04,Default,,0,0,0,,kanssa usein,
Dialogue: 0,0:04:02.22,0:04:03.90,Default,,0,0,0,,niin joskushan tämä osuu
Dialogue: 0,0:04:03.90,0:04:05.58,Default,,0,0,0,,ihan ykköseen nappiin.
Dialogue: 0,0:04:05.66,0:04:06.34,Default,,0,0,0,,Joskus pitää jonkun
Dialogue: 0,0:04:06.34,0:04:07.36,Default,,0,0,0,,verran muokata.
Dialogue: 0,0:04:07.36,0:04:09.28,Default,,0,0,0,,Tätä voi tästä lähteä
Dialogue: 0,0:04:09.28,0:04:10.60,Default,,0,0,0,,muokkaamaan.
Dialogue: 0,0:04:10.60,0:04:12.78,Default,,0,0,0,,Ei näin todellakaan.
Dialogue: 0,0:04:13.06,0:04:13.64,Default,,0,0,0,,Tai sitten,
Dialogue: 0,0:04:13.64,0:04:14.90,Default,,0,0,0,,otetaan nyt toi pois
Dialogue: 0,0:04:14.90,0:04:15.62,Default,,0,0,0,,tuolta.
Dialogue: 0,0:04:15.80,0:04:16.20,Default,,0,0,0,,Tai sitten mä voin
Dialogue: 0,0:04:16.20,0:04:17.80,Default,,0,0,0,,pyytää tästä chatista
Dialogue: 0,0:04:17.80,0:04:19.38,Default,,0,0,0,,muutoksia.
Dialogue: 0,0:04:19.50,0:04:20.24,Default,,0,0,0,,Tehdään tähän nyt vaikka
Dialogue: 0,0:04:20.24,0:04:20.84,Default,,0,0,0,,silleen,
Dialogue: 0,0:04:20.84,0:04:22.56,Default,,0,0,0,,että voisiko tämä olla
Dialogue: 0,0:04:22.56,0:04:24.92,Default,,0,0,0,,vähän lyhyempi.
Dialogue: 0,0:04:25.32,0:04:26.36,Default,,0,0,0,,Hetken jatkarisiin
Dialogue: 0,0:04:26.36,0:04:27.60,Default,,0,0,0,,miettii ja ehdottaa,
Dialogue: 0,0:04:27.60,0:04:28.04,Default,,0,0,0,,että miten tästä
Dialogue: 0,0:04:28.04,0:04:28.88,Default,,0,0,0,,tehtäisiin lyhyempi.
Dialogue: 0,0:04:28.88,0:04:30.82,Default,,0,0,0,,Mä voin hylkää tai
Dialogue: 0,0:04:30.82,0:04:33.46,Default,,0,0,0,,hylätä nämä muutokset,
Dialogue: 0,0:04:33.46,0:04:34.12,Default,,0,0,0,,hyväksytä nämä
Dialogue: 0,0:04:34.12,0:04:34.48,Default,,0,0,0,,muutokset.
Dialogue: 0,0:04:34.48,0:04:35.58,Default,,0,0,0,,Sitä voi myös täältä
Dialogue: 0,0:04:35.58,0:04:36.66,Default,,0,0,0,,laittaa silleen,
Dialogue: 0,0:04:36.66,0:04:37.70,Default,,0,0,0,,että analysoi tämä mun
Dialogue: 0,0:04:37.70,0:04:38.60,Default,,0,0,0,,postaus.
Dialogue: 0,0:04:38.74,0:04:40.08,Default,,0,0,0,,Postauksen analyysi tuli
Dialogue: 0,0:04:40.08,0:04:40.78,Default,,0,0,0,,tänne.
Dialogue: 0,0:04:40.78,0:04:41.46,Default,,0,0,0,,Sitten nähdään siitä,
Dialogue: 0,0:04:41.46,0:04:42.56,Default,,0,0,0,,että onko meidän aloitus
Dialogue: 0,0:04:42.56,0:04:43.52,Default,,0,0,0,,vahva.
Dialogue: 0,0:04:45.16,0:04:46.36,Default,,0,0,0,,Vastaako tämä meidän
Dialogue: 0,0:04:46.36,0:04:48.20,Default,,0,0,0,,omaa tone of voicea.
Dialogue: 0,0:04:48.20,0:04:48.96,Default,,0,0,0,,Miten me arvioidaan,
Dialogue: 0,0:04:48.96,0:04:49.76,Default,,0,0,0,,että tämä postaus tulisi
Dialogue: 0,0:04:49.76,0:04:51.00,Default,,0,0,0,,menestymään.
Dialogue: 0,0:04:51.26,0:04:52.40,Default,,0,0,0,,Mihin aiheeseen tämä
Dialogue: 0,0:04:52.40,0:04:53.30,Default,,0,0,0,,liittyy.
Dialogue: 0,0:04:53.30,0:04:54.56,Default,,0,0,0,,Tämän tyyppisiä juttuja,
Dialogue: 0,0:04:54.56,0:04:56.76,Default,,0,0,0,,jonka perusteella pystyy
Dialogue: 0,0:04:56.76,0:04:58.52,Default,,0,0,0,,mahdollisesti postaustaa
Dialogue: 0,0:04:58.52,0:04:59.28,Default,,0,0,0,,päivittämään.
Dialogue: 0,0:04:59.28,0:04:59.68,Default,,0,0,0,,Sitten me voidaan
Dialogue: 0,0:04:59.68,0:05:01.00,Default,,0,0,0,,laittaa tänne kuva.
Dialogue: 0,0:05:01.00,0:05:02.06,Default,,0,0,0,,Otetaan tuommoinen kuva.
Dialogue: 0,0:05:02.06,0:05:03.06,Default,,0,0,0,,Täällä on kuvagalleria.
Dialogue: 0,0:05:03.06,0:05:05.14,Default,,0,0,0,,Sitten kun me ollaan
Dialogue: 0,0:05:05.14,0:05:06.12,Default,,0,0,0,,valmiita,
Dialogue: 0,0:05:06.14,0:05:07.48,Default,,0,0,0,,me voidaan julkaista se
Dialogue: 0,0:05:07.48,0:05:08.34,Default,,0,0,0,,postaus.
Dialogue: 0,0:05:08.34,0:05:09.50,Default,,0,0,0,,Laittaa se tuosta
Dialogue: 0,0:05:09.50,0:05:11.86,Default,,0,0,0,,suoraan LinkedIniin.
Dialogue: 0,0:05:11.86,0:05:13.68,Default,,0,0,0,,Ympyrähän sulkeutuu
Dialogue: 0,0:05:13.68,0:05:14.20,Default,,0,0,0,,täällä
Dialogue: 0,0:05:14.20,0:05:16.26,Default,,0,0,0,,performance-näkymässä.
Dialogue: 0,0:05:16.38,0:05:17.34,Default,,0,0,0,,Sitten me nähdään,
Dialogue: 0,0:05:17.34,0:05:18.24,Default,,0,0,0,,että miten tämä meidän
Dialogue: 0,0:05:18.24,0:05:19.24,Default,,0,0,0,,postaus tai meidän
Dialogue: 0,0:05:19.24,0:05:20.32,Default,,0,0,0,,postaukset oikeasti
Dialogue: 0,0:05:20.32,0:05:22.97,Default,,0,0,0,,linkkarissa pärjää.
Dialogue: 0,0:05:23.16,0:05:23.96,Default,,0,0,0,,Täältä nähdään
Dialogue: 0,0:05:23.96,0:05:25.16,Default,,0,0,0,,esimerkiksi,
Dialogue: 0,0:05:25.36,0:05:26.62,Default,,0,0,0,,että Jaakko on
Dialogue: 0,0:05:26.62,0:05:28.00,Default,,0,0,0,,postaillut kaikenlaista.
Dialogue: 0,0:05:28.00,0:05:29.46,Default,,0,0,0,,Hirveitä madonlukuja on
Dialogue: 0,0:05:29.46,0:05:33.00,Default,,0,0,0,,viimeiset viikot ollut.
Dialogue: 0,0:05:33.00,0:05:33.74,Default,,0,0,0,,Nähdään,
Dialogue: 0,0:05:33.74,0:05:35.06,Default,,0,0,0,,että mistä aiheista me
Dialogue: 0,0:05:35.06,0:05:36.22,Default,,0,0,0,,postaillaan ja miten
Dialogue: 0,0:05:36.22,0:05:37.82,Default,,0,0,0,,usein me postaillaan.
Dialogue: 0,0:05:37.82,0:05:38.58,Default,,0,0,0,,Säännöllisyyshän on
Dialogue: 0,0:05:38.58,0:05:40.34,Default,,0,0,0,,tärkeää LinkedInin
Dialogue: 0,0:05:40.34,0:05:41.44,Default,,0,0,0,,postaileessa.
Dialogue: 0,0:05:41.44,0:05:42.10,Default,,0,0,0,,Sitten saadaan myös
Dialogue: 0,0:05:42.10,0:05:43.46,Default,,0,0,0,,tällaista analyysiä,
Dialogue: 0,0:05:43.46,0:05:44.42,Default,,0,0,0,,että minkä tyyppiset
Dialogue: 0,0:05:44.42,0:05:47.14,Default,,0,0,0,,sisällöt minulla toimii.
Dialogue: 0,0:05:47.14,0:05:48.18,Default,,0,0,0,,Että nämä toimii,
Dialogue: 0,0:05:48.18,0:05:49.46,Default,,0,0,0,,tämmöiset sisällöt.
Dialogue: 0,0:05:49.46,0:05:50.20,Default,,0,0,0,,Nämä jäävät aina vähän
Dialogue: 0,0:05:50.20,0:05:50.88,Default,,0,0,0,,hiljaiseksi.
Dialogue: 0,0:05:50.88,0:05:52.76,Default,,0,0,0,,Tällä perusteella pystyy
Dialogue: 0,0:05:52.76,0:05:53.52,Default,,0,0,0,,parantamaan
Dialogue: 0,0:05:53.52,0:05:56.02,Default,,0,0,0,,mahdollisesti sitä omaa
Dialogue: 0,0:05:56.02,0:05:57.14,Default,,0,0,0,,sisällöntuotantoa
Dialogue: 0,0:05:57.14,0:05:58.68,Default,,0,0,0,,suositumpaan suuntaan.
Dialogue: 0,0:05:58.68,0:05:59.24,Default,,0,0,0,,Tässä on,
Dialogue: 0,0:05:59.24,0:06:00.22,Default,,0,0,0,,miten arvioi toimii.
Dialogue: 0,0:06:00.22,0:06:02.52,Default,,0,0,0,,Tunti viikossa kirjautuu
Dialogue: 0,0:06:02.52,0:06:03.52,Default,,0,0,0,,tänne,
Dialogue: 0,0:06:03.52,0:06:04.06,Default,,0,0,0,,tekee haastattelu,
Dialogue: 0,0:06:04.06,0:06:04.94,Default,,0,0,0,,juttelee muutamasta
Dialogue: 0,0:06:04.94,0:06:05.52,Default,,0,0,0,,aiheesta.
Dialogue: 0,0:06:05.52,0:06:07.34,Default,,0,0,0,,Peräkkä ei saa viikon
Dialogue: 0,0:06:07.34,0:06:08.70,Default,,0,0,0,,verran postauksia ja
Dialogue: 0,0:06:08.70,0:06:10.34,Default,,0,0,0,,ajastaa ne täältä.
Dialogue: 0,0:06:10.76,0:06:12.02,Default,,0,0,0,,Homma rokkaa.
Dialogue: 0,0:06:12.24,0:06:13.52,Default,,0,0,0,,Jos kiinnostaa,
Dialogue: 0,0:06:13.52,0:06:14.26,Default,,0,0,0,,niin Voipi laittaa
Dialogue: 0,0:06:14.26,0:06:15.58,Default,,0,0,0,,viestiä.
Dialogue: 0,0:06:15.58,0:06:16.42,Default,,0,0,0,,Kiitos.
